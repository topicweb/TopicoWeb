.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Pero podemos subir ejemplos si existieran
# !.env.example

# Vercel
.vercel

# PWA / Service Workers
# Ignoramos archivos generados dinámicamente por next-pwa o workbox
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
build/

# IDEs & System files
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
/coverage

# Supabase (archivos locales generados por el CLI si se usara)
.supabase/
supabase/.temp/
# Local Netlify folder
.netlify

# Deno lock file (Netlify Edge Functions)
deno.lock
